---
import Layout from '../layouts/Layout.astro';
import courses from '../data/mockCourses.json';
---

<Layout title="Talleres Disponibles">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <header class="mb-14 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4 text-slate-900">
        Nuestros Talleres
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Explora nuestra oferta de talleres diseñados para potenciar tu desarrollo profesional.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {courses.map((course) => (
        <a href={`/curso/${course.id}`} class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-slate-100 flex flex-col group block">
          
          <div class="relative h-48 overflow-hidden bg-slate-200">
            <img 
              src={course.coverImage} 
              alt={`Portada de ${course.title}`} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>

          <div class="p-6 flex flex-col flex-grow">
            <div class="flex gap-2 mb-3">
              <span class="bg-indigo-100 text-indigo-800 text-xs font-bold px-2.5 py-1 rounded-full">
                {course.modality}
              </span>
              <span class="bg-slate-100 text-slate-700 text-xs font-semibold px-2.5 py-1 rounded-full">
                {course.duration}
              </span>
            </div>

            <h2 class="text-xl font-bold mb-2 leading-tight text-slate-800">
              {course.title}
            </h2>
            <p class="text-slate-600 text-sm mb-6 flex-grow">
              {course.shortDescription}
            </p>
            
            <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-slate-100">
              {course.tags.map((tag) => (
                <span class="text-xs text-slate-500 bg-slate-50 border border-slate-200 px-2 py-1 rounded-md">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>