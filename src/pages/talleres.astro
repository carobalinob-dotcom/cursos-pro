---
import Layout from '../layouts/Layout.astro';
import courses from '../data/mockCourses.json';
---

<Layout title="Talleres Disponibles">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <header class="mb-14 text-center">
      <!-- Título con tipografía Serif y color oscuro -->
      <h1 class="text-4xl md:text-5xl font-serif text-[#2B2B2B] mb-4">
        Nuestros Talleres
      </h1>
      <!-- Subtítulo en tono café claro -->
      <p class="text-lg text-[#A88C75] max-w-2xl mx-auto">
        Explora nuestra oferta de talleres diseñados para potenciar tu desarrollo profesional.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {courses.map((course) => (
        <a href={`/curso/${course.id}`} class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-[#EADCD1] flex flex-col group block">
          
          <!-- Contenedor de imagen: Fondo crema por si la imagen tarda en cargar -->
          <div class="relative h-48 overflow-hidden bg-[#E2E8F0]">
            <img 
              src={course.coverImage} 
              alt={`Portada de ${course.title}`} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>

          <div class="p-6 flex flex-col flex-grow">
            <!-- Insignias (Badges) adaptadas a la paleta -->
            <div class="flex gap-2 mb-3">
              <span class="bg-[#EADCD1] text-[#2B2B2B] text-xs font-bold px-2.5 py-1 rounded-full">
                {course.modality}
              </span>
              <span class="bg-[#F7F3EF] text-[#A88C75] text-xs font-semibold px-2.5 py-1 rounded-full">
                {course.duration}
              </span>
            </div>

            <!-- Título de la tarjeta en Serif -->
            <h2 class="text-xl font-serif text-[#2B2B2B] mb-2 leading-tight">
              {course.title}
            </h2>
            
            <!-- Descripción en tono café claro -->
            <p class="text-[#A88C75] text-sm mb-6 flex-grow">
              {course.shortDescription}
            </p>
            
            <!-- Etiquetas (Tags) inferiores con bordes cálidos -->
            <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-[#EADCD1]">
              {course.tags.map((tag) => (
                <span class="text-xs text-[#A88C75] bg-white border border-[#EADCD1] px-2 py-1 rounded-md">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>