---
import Layout from '../layouts/Layout.astro';
import { contentfulClient } from '../lib/contentful.js';

// 1. Pedimos los productos a Contentful
const entries = await contentfulClient.getEntries({
  content_type: 'productos', // Este debe ser el ID de tu modelo en Contentful
});

// 2. Mapeamos los datos crudos para que tu diseño los entienda igual que el JSON
const products = entries.items.map((item) => {
  return {
    id: item.fields.slug, 
    name: item.fields.nombre,
    price: item.fields.precio || 0, // Ponemos un 0 por defecto por si olvidan poner precio
    category: item.fields.categoria,
    isNew: item.fields.nuevo,
    // Contentful guarda la imagen en esta ruta, así que la extraemos:
    image: item.fields.imagen?.fields?.file?.url || '', 
  };
});
---

<Layout title="Tienda - Nuestros Productos">
  <main class="max-w-6xl mx-auto px-6 py-16">
    
    <header class="mb-14 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4 text-[#2B2B2B]">
        Tienda Oficial
      </h1>
      <p class="text-lg text-[#A88C75] max-w-2xl mx-auto">
        Mercancía exclusiva y herramientas para tu desarrollo profesional.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((product) => (
        <a href={`/producto/${product.id}`} class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-[#EADCD1] flex flex-col group block">
          
          <div class="relative h-48 overflow-hidden bg-[#F7F3EF]">
            <img 
              src={product.image} 
              alt={product.name} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            {product.isNew && (
              <span class="absolute top-3 left-3 bg-[#A88C75] text-[#F7F3EF] text-xs font-bold px-3 py-1 rounded-full shadow-md tracking-widest uppercase">
                NUEVO
              </span>
            )}
          </div>

          <div class="p-6 flex flex-col flex-grow">
            <div class="flex gap-2 mb-3">
              <span class="bg-[#EADCD1] text-[#2B2B2B] text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wide">
                {product.category}
              </span>
            </div>

            <h2 class="text-xl font-serif text-[#2B2B2B] mb-2 leading-tight flex-grow">
              {product.name}
            </h2>
            
            <div class="mt-4 pt-4 border-t border-[#EADCD1] flex justify-between items-center">
              <span class="text-2xl font-serif text-[#2B2B2B]">
                ${product.price.toFixed(2)}
              </span>
              <span class="text-sm font-medium text-[#A88C75] group-hover:text-[#2B2B2B] transition-colors">
                Ver detalles &rarr;
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>