---
// src/pages/producto/[id].astro
import Navbar from '../../components/Navbar.astro';
import { contentfulClient } from '../../lib/contentful.js';

// Generamos las rutas dinámicas consultando a Contentful
export async function getStaticPaths() {
  const entries = await contentfulClient.getEntries({
    content_type: 'productos', 
  });

  return entries.items.map((item) => {
    return {
      params: { id: item.fields.slug },
      props: { 
        product: {
          id: item.fields.slug,
          name: item.fields.nombre,
          price: item.fields.precio || 0,
          category: item.fields.categoria,
          isNew: item.fields.nuevo,
          image: item.fields.imagen?.fields?.file?.url || '',
          description: item.fields.descripcion || 'Sin descripción disponible.',
          whatsapp: item.fields.enlace || '#'
        }
      },
    };
  });
}

const { product } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{product.name} - Rachel Studio</title>
  </head>
  <body class="bg-white min-h-screen text-[#2B2B2B] font-sans flex flex-col">
    
    <Navbar />

    <main class="max-w-6xl mx-auto px-6 py-12 md:py-20 flex-grow w-full">
      
      <!-- Botón de regreso -->
      <a href="/productos" class="inline-flex items-center text-lg font-serif italic text-[#A88C75] hover:text-[#2B2B2B] transition-colors duration-300 mb-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 not-italic" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Volver a la tienda
      </a>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-start">
        
        <!-- Columna Izquierda: Imagen del Producto -->
        <div class="relative bg-[#E2E8F0] rounded-3xl overflow-hidden shadow-sm border border-slate-200">
          <img 
            src={product.image} 
            alt={product.name} 
            class="w-full h-auto object-cover aspect-[4/5]"
          />
          {product.isNew && (
            <span class="absolute top-6 left-6 bg-[#A88C75] text-[#F7F3EF] text-xs font-bold px-4 py-1.5 rounded-full shadow-md tracking-widest uppercase">
              NUEVO
            </span>
          )}
        </div>

        <!-- Columna Derecha: Detalles e Interacción -->
        <div class="flex flex-col h-full justify-center">
          
          <span class="text-sm font-bold text-[#A88C75] uppercase tracking-widest mb-3 block">
            {product.category}
          </span>
          
          <h1 class="text-3xl md:text-4xl font-serif text-[#2B2B2B] leading-tight mb-4">
            {product.name}
          </h1>
          
          <p class="text-3xl font-serif text-[#2B2B2B] mb-8">
            ${product.price.toFixed(2)}
          </p>
          
          <!-- Descripción Real conectada a Contentful -->
          <p class="text-[#A88C75] leading-relaxed mb-10 text-lg whitespace-pre-line">
            {product.description}
          </p>

          <hr class="border-[#EADCD1] mb-10" />

          <!-- Botón de compra (Conectado a WhatsApp) -->
          <a href={product.whatsapp} target="_blank" rel="noopener noreferrer" class="w-full block text-center bg-[#A88C75] hover:bg-[#2B2B2B] text-[#F7F3EF] font-serif text-lg tracking-widest uppercase py-4 px-8 transition-colors duration-300 shadow-md">
            Comprar por WhatsApp
          </a>
          
          <!-- Beneficios extra -->
          <ul class="mt-8 space-y-3 text-sm text-[#A88C75] font-medium">
            <li class="flex items-center">
              <svg class="h-5 w-5 mr-3 text-[#2B2B2B]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
              Envío disponible a nivel nacional
            </li>
            <li class="flex items-center">
              <svg class="h-5 w-5 mr-3 text-[#2B2B2B]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
              Garantía de calidad garantizada
            </li>
          </ul>

        </div>
      </div>
    </main>

  </body>
</html>