---
// src/pages/curso/[id].astro
import Navbar from '../../components/Navbar.astro';
import { contentfulClient } from '../../lib/contentful.js';

// Esta función lee Contentful y le dice a Astro qué páginas debe generar
export async function getStaticPaths() {
  const entries = await contentfulClient.getEntries({
    content_type: 'talleres', 
  });

  return entries.items.map((item) => {
    return {
      params: { id: item.fields.slug },
      props: { 
        course: {
          id: item.fields.slug,
          title: item.fields.nombre,
          modality: item.fields.modalidad || 'Por definir',
          duration: item.fields.duracionHoras ? `${item.fields.duracionHoras} Horas` : 'N/A',
          shortDescription: item.fields.descripcion || 'Sin descripción disponible.',
          coverImage: item.fields.imagen?.fields?.file?.url || '',
          tags: item.fields.temas ? item.fields.temas.split(',').map(tag => tag.trim()) : [],
          whatsapp: item.fields.enlace || '#'
        }
      },
    };
  });
}

// Extraemos la información del curso actual
const { course } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{course.title} - Rachel Studio</title>
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body class="bg-[#F7F3EF] min-h-screen text-[#2B2B2B] font-sans flex flex-col">
    
    <Navbar />

    <main class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
      <a href="/talleres" class="text-[#A88C75] hover:text-[#2B2B2B] transition-colors duration-300 mb-8 inline-block font-serif italic text-lg">
        &larr; Volver al catálogo
      </a>
      
      <!-- Contenedor principal de los detalles -->
      <div class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-[#2B2B2B]">
        <div class="flex gap-3 mb-6">
          <span class="bg-[#EADCD1] text-[#2B2B2B] text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wide">
            {course.modality}
          </span>
          <span class="bg-[#F7F3EF] text-[#A88C75] text-xs font-semibold px-3 py-1.5 rounded-full uppercase tracking-wide">
            {course.duration}
          </span>
        </div>
        
        <h1 class="text-4xl md:text-5xl font-serif mb-6 text-[#2B2B2B] leading-tight">
          {course.title}
        </h1>
        
        <img 
          src={course.coverImage} 
          alt={`Portada de ${course.title}`} 
          class="w-full h-80 object-cover rounded-2xl mb-8 shadow-sm" 
        />
        
        <!-- Agregamos whitespace-pre-line para respetar los párrafos creados en Contentful -->
        <p class="text-lg text-[#A88C75] leading-relaxed mb-10 whitespace-pre-line">
          {course.shortDescription}
        </p>
        
        <h2 class="text-2xl font-serif mb-6 text-[#2B2B2B]">Temas a tratar</h2>
        <div class="flex flex-wrap gap-3 mb-10">
          {course.tags.map((tag) => (
            <span class="bg-white border border-[#EADCD1] text-[#A88C75] px-4 py-2 rounded-lg text-sm font-medium">
              {tag}
            </span>
          ))}
        </div>

        <hr class="border-[#EADCD1] mb-8" />

        <!-- Botón de inscripción conectado al enlace de Contentful -->
        <a href={course.whatsapp} target="_blank" rel="noopener noreferrer" class="w-full block text-center bg-[#2B2B2B] hover:bg-[#A88C75] text-[#F7F3EF] font-serif text-lg tracking-widest uppercase py-4 px-8 rounded-xl transition-colors duration-300 shadow-md">
          Inscribirme por WhatsApp
        </a>

      </div>
    </main>
  </body>
</html>