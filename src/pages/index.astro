---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inicio - Nuestro Negocio">
  <main class="max-w-6xl mx-auto px-6 py-20 flex flex-col items-center text-center">

    <!-- Imagen representativa -->
    <div class="w-full max-w-5xl rounded-3xl overflow-hidden shadow-2xl relative mb-16">
      <img 
        src="https://placehold.co/1200x600/e2e8f0/1e293b?text=Fotograf%C3%ADa+del+Negocio" 
        alt="Instalaciones o ambiente del negocio" 
        class="w-full h-auto object-cover"
      />
    </div>

    <!-- Título principal Elegante -->
    <h1 class="text-4xl md:text-6xl font-serif text-[#2B2B2B] leading-tight mb-6">
      Transformando la forma <br class="hidden md:block" /> de <span class="italic text-[#A88C75]">aprender.</span>
    </h1>
    
    <!-- Resumen del negocio -->
    <p class="text-xl text-stone-600 max-w-3xl mb-10 leading-relaxed">
      Somos un centro de formación dedicado a impulsar el desarrollo profesional. Ofrecemos talleres prácticos, metodologías modernas y un ambiente diseñado para que alcances tu máximo potencial.
    </p>
    
    <!-- Botón Call to Action Elegante -->
    <a href="/talleres" class="inline-block bg-[#A88C75] text-[#F7F3EF] px-10 py-4 font-serif text-lg tracking-widest uppercase hover:bg-[#2B2B2B] transition-colors duration-300 mb-16">
      Ver Talleres Disponibles
    </a>
    

  </main>
</Layout>