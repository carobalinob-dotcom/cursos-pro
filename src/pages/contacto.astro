---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto - Escríbenos">
  <main class="max-w-6xl mx-auto px-6 py-16">
    
    <header class="mb-14 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4 text-slate-900">
        Contáctanos
      </h1>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        ¿Tienes alguna duda o quieres colaborar con nosotros? Escríbenos y nos comunicaremos contigo lo antes posible.
      </p>
    </header>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-2">
        
        <div class="p-8 md:p-12 bg-slate-900 text-white flex flex-col justify-center">
          <h2 class="text-2xl font-bold mb-8">Información Directa</h2>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="bg-slate-800 p-3 rounded-full text-indigo-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-100">Nuestra Oficina</h3>
                <p class="text-slate-400 text-sm mt-1">Av. Principal y Calle Secundaria<br/>Guayaquil, Ecuador</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="bg-slate-800 p-3 rounded-full text-indigo-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-100">Correo Electrónico</h3>
                <p class="text-slate-400 text-sm mt-1">hola@catalogo.pro</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="bg-slate-800 p-3 rounded-full text-indigo-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-slate-100">Teléfono</h3>
                <p class="text-slate-400 text-sm mt-1">+593 99 000 0000</p>
              </div>
            </div>
          </div>
        </div>

        <div class="p-8 md:p-12">
          <form class="flex flex-col gap-6">
            
            <div>
              <label for="nombre" class="block text-sm font-semibold text-slate-700 mb-2">Nombre completo</label>
              <input type="text" id="nombre" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-transparent transition-all" placeholder="Ej. Juan Pérez">
            </div>
            
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Correo electrónico</label>
              <input type="email" id="email" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-transparent transition-all" placeholder="juan@ejemplo.com">
            </div>

            <div>
              <label for="mensaje" class="block text-sm font-semibold text-slate-700 mb-2">Mensaje</label>
              <textarea id="mensaje" rows="4" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-transparent transition-all resize-none" placeholder="¿En qué te podemos ayudar?"></textarea>
            </div>

            <button type="button" class="mt-2 bg-indigo-600 text-white font-semibold py-3.5 px-6 rounded-xl hover:bg-slate-900 transition-colors shadow-sm">
              Enviar mensaje
            </button>
            
          </form>
        </div>

      </div>
    </div>
  </main>
</Layout>