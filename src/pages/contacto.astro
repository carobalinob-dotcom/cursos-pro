---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto - Rachel Studio">
  <main class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    
    <!-- Encabezado -->
    <header class="mb-16 text-center">
      <h1 class="text-4xl md:text-5xl font-serif mb-4 text-[#2B2B2B]">
        Contáctanos
      </h1>
      <p class="text-lg text-[#A88C75] max-w-2xl mx-auto">
        ¿Tienes alguna duda o quieres colaborar con nosotros? Encuentra la mejor forma de comunicarte y te responderemos a la brevedad.
      </p>
    </header>

    <!-- Cuadrícula de Información (3 Columnas) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      
      <!-- Tarjeta: Oficina -->
      <div class="bg-white rounded-3xl p-10 text-center shadow-sm border border-[#EADCD1] flex flex-col items-center group hover:shadow-md transition-shadow duration-300">
        <div class="bg-[#F7F3EF] p-5 rounded-full text-[#A88C75] mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="font-serif text-xl text-[#2B2B2B] mb-2">Nuestra Oficina</h3>
        <p class="text-[#A88C75] leading-relaxed">Av. Principal y Calle Secundaria<br/>Guayaquil, Ecuador</p>
      </div>

      <!-- Tarjeta: Correo Electrónico -->
      <div class="bg-white rounded-3xl p-10 text-center shadow-sm border border-[#EADCD1] flex flex-col items-center group hover:shadow-md transition-shadow duration-300">
        <div class="bg-[#F7F3EF] p-5 rounded-full text-[#A88C75] mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="font-serif text-xl text-[#2B2B2B] mb-2">Correo Electrónico</h3>
        <p class="text-[#A88C75] leading-relaxed">hola@rachelstudio.com</p>
      </div>

      <!-- Tarjeta: Teléfono / WhatsApp -->
      <div class="bg-white rounded-3xl p-10 text-center shadow-sm border border-[#EADCD1] flex flex-col items-center group hover:shadow-md transition-shadow duration-300">
        <div class="bg-[#F7F3EF] p-5 rounded-full text-[#A88C75] mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <h3 class="font-serif text-xl text-[#2B2B2B] mb-2">Teléfono</h3>
        <p class="text-[#A88C75] leading-relaxed">+593 99 000 0000</p>
      </div>

    </div>
  </main>
</Layout>