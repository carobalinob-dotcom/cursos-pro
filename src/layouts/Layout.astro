---
// src/layouts/Layout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Recibimos el título de la página, con un valor por defecto
const { title = "Catálogo Pro" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    
    <!-- Íconos de la pestaña del navegador -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
  </head>
  <body class="bg-white text-[#2B2B2B] min-h-screen flex flex-col font-sans">
    
    <Navbar />
    
    <!-- Contenedor principal expansible -->
    <div class="flex-grow">
      <slot />
    </div>

    <Footer />
    
  </body>
</html>