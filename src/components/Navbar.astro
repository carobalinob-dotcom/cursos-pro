---
// src/components/Navbar.astro
---

<!-- Barra de navegación principal -->
<nav class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/70 border-b border-slate-200">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="text-xl font-extrabold text-slate-900 tracking-tight">
      Catálogo<span class="text-indigo-600">.Pro</span>
    </a>
    
    <!-- Botón de Menú (Hamburguesa) -->
    <button id="menu-open" class="text-slate-900 hover:text-indigo-600 focus:outline-none transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</nav>

<!-- Menú Pantalla Completa (Overlay) -->
<div id="fullscreen-menu" class="fixed inset-0 bg-white z-[60] opacity-0 pointer-events-none transition-opacity duration-300 flex flex-col">
  
  <!-- Cabecera del Menú -->
  <div class="px-6 h-16 flex items-center justify-between w-full max-w-6xl mx-auto mt-2">
    <!-- Logo dentro del menú -->
    <a href="/" class="text-xl font-extrabold text-slate-900 tracking-tight">
      Catálogo<span class="text-indigo-600">.Pro</span>
    </a>
    
    <!-- Botón de Cerrar (X) -->
    <button id="menu-close" class="text-slate-500 hover:text-slate-900 focus:outline-none transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 font-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Enlaces del Menú (Centrados) -->
  <div class="flex-grow flex flex-col items-center justify-center space-y-8 pb-20">
    <a href="/" class="text-lg text-slate-500 hover:text-slate-900 tracking-widest uppercase transition-colors">Inicio</a>
    <a href="/talleres" class="text-lg text-slate-500 hover:text-slate-900 tracking-widest uppercase transition-colors">Talleres</a>
    
    <!-- Nuevo enlace para el catálogo de productos -->
    <a href="/productos" class="text-lg text-slate-500 hover:text-slate-900 tracking-widest uppercase transition-colors text-center">Productos</a>
    
    <a href="/contacto" class="text-lg text-slate-500 hover:text-slate-900 tracking-widest uppercase transition-colors">Contacto</a>
    
  </div>
</div>

<!-- Lógica de interactividad -->
<script>
  const menuOpen = document.getElementById('menu-open');
  const menuClose = document.getElementById('menu-close');
  const fullscreenMenu = document.getElementById('fullscreen-menu');

  // El 'if' le asegura al editor que los elementos sí existen, quitando el error rojo
  if (menuOpen && menuClose && fullscreenMenu) {
    
    menuOpen.addEventListener('click', () => {
      fullscreenMenu.classList.remove('opacity-0', 'pointer-events-none');
      fullscreenMenu.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden'; 
    });

    menuClose.addEventListener('click', () => {
      fullscreenMenu.classList.remove('opacity-100', 'pointer-events-auto');
      fullscreenMenu.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = ''; 
    });
    
  }
</script>